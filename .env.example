# ==================== SFTP 云端同步配置 ====================
# 复制此文件为 .env 并填入你的服务器信息
# cp .env.example .env

# SFTP 服务器地址（必填）
SFTP_HOST=your.server.com

# SFTP 端口（默认 22）
SFTP_PORT=22

# SFTP 用户名（必填）
SFTP_USER=your_username

# SFTP 密码（密钥认证时可留空）
SFTP_PASSWORD=

# SSH 私钥路径（优先于密码认证）
SFTP_KEY_PATH=~/.ssh/id_rsa

# 远程存储目录
SFTP_REMOTE_DIR=/home/your_username/password-sync
